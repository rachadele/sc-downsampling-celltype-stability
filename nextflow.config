/*
 * Nextflow configuration for downsampling experiment
 */

// Default parameters
params {
    // Input/Output
    organism = "homo_sapiens"

    input_data = "$projectDir/data/${params.organism}/Human_Multiple_Cortical_Areas_SMART-seq.h5ad"  // Pre-downloaded reference dataset
    // Set to null to download fresh, or provide path to existing h5ad

    // CellxGene Census parameters
    dataset_name = "Multiple_Cortical_Areas_SMART-seq"
    census_version = "2024-07-01"
    n_cells = 5000  // Number of cells to subsample (set to 0 for all cells)
    output_prefix = "reference"

    // Data splitting parameters
    test_size = 0.3
    stratify_key = "cell_type"

    // Downsampling parameters
    // Testing from 10x-like depths up to typical Smart-seq v4 depths
    //depth_levels = [10000, 50000, 100000, 250000, 500000, 1000000]
    //reduce depth levels
    depth_levels = [50, 100, 250, 500, 1000, 5000, 10000, 15000, 25000, 50000, 100000]
    seeds = [42, 123]  // Two seeds for paired replicates

    // Cell type annotation
    label_key = "cell_type"

    outdir = "$projectDir/${params.organism}/${params.dataset_name}/${params.census_version}"

    // Seurat parameters
    dims = 50
    normalization_method = "SCT"

    // Analysis
    stability_threshold = 0.95

    // Conda environments
    scanpy_env = "/home/rschwartz/anaconda3/envs/scanpyenv"
    r_env = "/home/rschwartz/anaconda3/envs/r4.3"

}

// Process-specific settings
process {
    // Default resources
    cpus = 4
    memory = '16 GB'
    time = '2h'

    // Process-specific overrides
    withName: 'DOWNLOAD_DATA' {
        memory = '32 GB'
        time = '4h'
    }

    withName: 'SEURAT_PROCESSING' {
        memory = '32 GB'
        time = '4h'
    }

    withName: 'DOWNSAMPLE' {
        memory = '16 GB'
        time = '1h'
    }

    withName: 'PREDICT_SEURAT' {
        memory = '32 GB'
        time = '2h'
    }

    withName: 'PREDICT_SCVI' {
        memory = '16 GB'
        time = '1h'
    }

    withName: 'COMPARE_REPLICATES' {
        memory = '8 GB'
        time = '30m'
    }

    withName: 'PLOT_RESULTS' {
        memory = '8 GB'
        time = '30m'
    }
}

// Execution profiles

process.executor = 'slurm'
//process.queue = 'normal'
 process.clusterOptions = '-C thrd64 --cpus-per-task=8'

profiles {

    conda {
        conda.enabled = true
    }
}

// Default to conda profile
conda.enabled = true

// Execution settings


// Logging
trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/timeline.html"
    overwrite = true
}

// Manifest
manifest {
    name = 'downsampling-experiment'
    author = 'Your Name'
    description = 'Pipeline to determine minimum sequencing depth for stable cell type calling'
    version = '1.0.0'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.04.0'
}
